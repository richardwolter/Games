[gd_scene load_steps=7 format=3]

; The bloom: a fungus grown past the point of being one creature. It braces and
; fires a beam down the line it braced along, and it seeds smaller fungi that
; fight exactly like the ordinary bestiary ones.
;
; Both of those arrive with src/boss_fungus.gd. Until then this runs the plain
; CHARGER off src/enemy.gd -- the bracing rhythm the beam will be hung on is
; already that behaviour, so the fight is recognisable from the first commit and
; the script swap changes what the windup RELEASES, not what it looks like.

[ext_resource type="Script" path="res://src/enemy.gd" id="1_fungus"]
[ext_resource type="Script" path="res://src/hurtbox.gd" id="2_hurtbox"]
[ext_resource type="Shader" path="res://src/enemy_body.gdshader" id="3_body"]
[ext_resource type="Texture2D" path="res://art/enemies/fungus.png" id="4_fungus"]

