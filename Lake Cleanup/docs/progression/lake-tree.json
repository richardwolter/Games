  "cargo": 18,
  "boats": 0,
  "dog_fetch": 1,
  "dog_wait_cut": 0,
  "k_lake_r": 36.88,
  "k_island_r": 9.58,
  "k_units_total": 16264,
  "k_stack": 4.071,
  "k_density": 1.2,
  "k_reel_factor": 0.977,
  "k_aim": 2.0,
  "k_cast_share": 0.75,
  "k_mouth_edge": 0.15,
  "k_ferry_leg": 24.19,
  "k_ferry_fixed": 6.33,
  "k_material_share": 0.3,
  "k_stack_slots": 4,
  "k_skim_factor": 1.4,
  "k_dog_trip": 8,
  "k_dog_carry": 2.2,
  "k_dog_reach": 6,
  "k_dog_carry_share": 0.5,
  "k_strand": 448,
  "k_strand_band": 2.5,
  "k_units_t0": 6337,
  "k_units_t1": 3896,
  "k_units_t2": 2769,
  "k_units_t3": 1551,
  "k_units_t4": 1711,
  "dog": 0,
  "dog_beach": 0.35,
  "dog_strand_speed": 1.0,
  "dog_reach": 6
 },
 "derived": [
  [
   "coverage",
   "(min(k_lake_r, k_island_r + net_range) ^ 2 - k_island_r ^ 2) / (k_lake_r ^ 2 - k_island_r ^ 2)"
  ],
  [
   "dog_coverage",
   "(min(k_lake_r, k_island_r + dog_reach) ^ 2 - k_island_r ^ 2) / (k_lake_r ^ 2 - k_island_r ^ 2) * k_dog_carry_share"
  ],
  [
   "strand_reach",
   "clamp((k_island_r + net_range + net_radius - k_lake_r) / k_strand_band, 0, 1)"
  ],
  [
   "access_now",
   "max(0, pool_lake_t0 - k_units_t0 * (1 - coverage)) * (net_power >= 0) + max(0, pool_lake_t1 - k_units_t1 * (1 - coverage)) * (net_power >= 1) + max(0, pool_lake_t2 - k_units_t2 * (1 - coverage)) * (net_power >= 2) + max(0, pool_lake_t3 - k_units_t3 * (1 - coverage)) * (net_power >= 3) + max(0, pool_lake_t4 - k_units_t4 * (1 - coverage)) * (net_power >= 4) + max(0, pool_strand - k_strand * (1 - strand_reach))"
  ],
  [
   "density",
   "k_density * access_now / max(coverage * k_units_total + strand_reach * k_strand, 1)"
  ],
  [
   "cast_dist",
   "net_range * k_cast_share"
  ],
  [
   "mouth",
   "net_radius + k_mouth_edge"
  ],
  [
   "swept",
   "2 * mouth * cast_dist + PI * mouth ^ 2"
  ],
  [
   "per_cast",
   "min(net_hold, swept * density)"
  ],
  [
   "cast_cycle",
   "k_aim + cast_dist / 26 + k_reel_factor * cast_dist / reel"
  ],
  [
   "catch_rate",
   "per_cast / cast_cycle"
  ],
  [
   "ferry_trip",
   "k_ferry_fixed + 2 * k_ferry_leg / boat_speed"
  ],
  [
   "ferry_rate",
   "boats * cargo / ferry_trip"
  ],
  [
   "dog_near_left",
   "max(0, pool_lake_t0 - k_units_t0 * (1 - dog_coverage))"
  ],
  [
   "dog_beach_share",
   "dog_near_left > 5 ? dog_beach : 1"
  ],
  [
   "dog_rate",
   "dog * min(dog_fetch, k_dog_carry) / (k_dog_trip + max(10 - dog_wait_cut, 3))"
  ]
 ],
