  "k_units_t4": 1711
 },
 "derived": [
  [
   "coverage",
   "(min(k_lake_r, k_island_r + net_range) ^ 2 - k_island_r ^ 2) / (k_lake_r ^ 2 - k_island_r ^ 2)"
  ],
  [
   "dog_coverage",
   "(min(k_lake_r, k_island_r + k_dog_reach) ^ 2 - k_island_r ^ 2) / (k_lake_r ^ 2 - k_island_r ^ 2) * k_dog_carry_share"
  ],
  [
   "strand_reach",
   "clamp((k_island_r + net_range + net_radius - k_lake_r) / k_strand_band, 0, 1)"
  ],
  [
   "access_now",
   "max(0, pool_lake_t0 - k_units_t0 * (1 - coverage)) * (net_power >= 0) + max(0, pool_lake_t1 - k_units_t1 * (1 - coverage)) * (net_power >= 1) + max(0, pool_lake_t2 - k_units_t2 * (1 - coverage)) * (net_power >= 2) + max(0, pool_lake_t3 - k_units_t3 * (1 - coverage)) * (net_power >= 3) + max(0, pool_lake_t4 - k_units_t4 * (1 - coverage)) * (net_power >= 4) + max(0, pool_strand - k_strand * (1 - strand_reach))"
  ],
  [
   "density",
   "k_density * access_now / max(coverage * k_units_total + strand_reach * k_strand, 1)"
  ],
  [
   "cast_dist",
   "net_range * k_cast_share"
  ],
  [
   "mouth",
   "net_radius + k_mouth_edge"
  ],
  [
   "swept",
   "2 * mouth * cast_dist + PI * mouth ^ 2"
  ],
  [
   "per_cast",
   "min(net_hold, swept * density)"
  ],
  [
   "cast_cycle",
   "k_aim + cast_dist / 26 + k_reel_factor * cast_dist / reel"
  ],
  [
   "catch_rate",
   "per_cast / cast_cycle"
  ],
  [
   "ferry_trip",
   "k_ferry_fixed + 2 * k_ferry_leg / boat_speed"
  ],
  [
   "ferry_rate",
   "boats * cargo / ferry_trip"
  ],
  [
   "trips",
   "min(boats / ferry_trip, rate_ferry)"
  ],
  [
   "avg_lot",
   "rate_ferry / max(trips, 0.000001)"
  ],
  [
   "skim_room",
   "skimmer + max(0, cargo - avg_lot)"
  ],
  [
   "skim_chance",
   "skimmer >= 1 ? lerp(0.3, 1, (skimmer - 1) / 9) : 0"
  ],
  [
   "skim_power",
   "floor(max(skimmer - 1, 0) / 2)"
  ],
  [
   "skim_left",
   "(pool_lake_t0 * (skim_power >= 0) + pool_lake_t1 * (skim_power >= 1) + pool_lake_t2 * (skim_power >= 2) + pool_lake_t3 * (skim_power >= 3) + pool_lake_t4 * (skim_power >= 4)) / k_units_total"
  ],
  [
   "skim_found",
   "k_skim_factor * k_ferry_leg * (2 * (skimmer - 1) + 1) * k_stack * min(1, (skimmer + 1) / k_stack_slots) * k_material_share * skim_left * skim_chance"
  ],
  [
   "skim_rate",
   "skimmer >= 1 ? trips * min(skim_room, skim_found) : 0"
  ],
  [
   "dog_rate",
   "min(dog_fetch, k_dog_carry) / (k_dog_trip + max(10 - dog_wait_cut, 3))"
  ]
 ],
