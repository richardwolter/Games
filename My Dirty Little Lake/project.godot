; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="My Dirty Little Lake"
config/version="0.1.0"
run/main_scene="res://scenes/boot.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="My Dirty Little Lake"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0706, 0.1804, 0.0549, 1)
boot_splash/stretch_mode=4
boot_splash/image="res://assets/boot_splash.png"
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[audio]

driver/output_latency=8

[autoload]

Prefs="*res://scripts/prefs.gd"
Pad="*res://scripts/pad.gd"
Sound="*res://scripts/sfx.gd"
Music="*res://scripts/music_station.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=false

[dotnet]

project/assembly_name="My Dirty Little Lake"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[input]

walk_left={
"deadzone": 0.2,
"events": []
}
walk_right={
"deadzone": 0.2,
"events": []
}
walk_up={
"deadzone": 0.2,
"events": []
}
walk_down={
"deadzone": 0.2,
"events": []
}
cast={
"deadzone": 0.2,
"events": []
}
interact={
"deadzone": 0.2,
"events": []
}
open_shed={
"deadzone": 0.2,
"events": []
}
open_upgrades={
"deadzone": 0.2,
"events": []
}
open_settings={
"deadzone": 0.2,
"events": []
}
zoom_in={
"deadzone": 0.2,
"events": []
}
zoom_out={
"deadzone": 0.2,
"events": []
}
recentre={
"deadzone": 0.2,
"events": []
}
shed_rotate={
"deadzone": 0.2,
"events": []
}
aim_left={
"deadzone": 0.2,
"events": []
}
aim_right={
"deadzone": 0.2,
"events": []
}
aim_up={
"deadzone": 0.2,
"events": []
}
aim_down={
"deadzone": 0.2,
"events": []
}
pad_back={
"deadzone": 0.2,
"events": []
}

[rendering]

renderer/rendering_method="gl_compatibility"

[shader_globals]

lake_clock={
"type": "float",
"value": 0.0
}
