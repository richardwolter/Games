 },
 "derived": [
  [
   "coverage",
   "(min(k_lake_r, k_island_r + (net_range * (k_lake_r - k_island_r) / k_reach_far)) ^ 2 - k_island_r ^ 2) / (k_lake_r ^ 2 - k_island_r ^ 2)"
  ],
  [
   "dog_coverage",
   "(min(k_lake_r, k_island_r + dog_reach) ^ 2 - k_island_r ^ 2) / (k_lake_r ^ 2 - k_island_r ^ 2) * k_dog_carry_share"
  ],
  [
   "strand_reach",
   "clamp((k_island_r + (net_range * (k_lake_r - k_island_r) / k_reach_far) + net_radius - k_lake_r) / k_strand_band, 0, 1)"
  ],
  [
   "access_now",
   "max(0, pool_lake_t0 - k_units_t0 * (1 - coverage)) * (net_power >= 0) + max(0, pool_lake_t1 - k_units_t1 * (1 - coverage)) * (net_power >= 1) + max(0, pool_lake_t2 - k_units_t2 * (1 - coverage)) * (net_power >= 2) + max(0, pool_lake_t3 - k_units_t3 * (1 - coverage)) * (net_power >= 3) + max(0, pool_lake_t4 - k_units_t4 * (1 - coverage)) * (net_power >= 4) + max(0, pool_strand - k_strand * (1 - strand_reach))"
  ],
  [
   "density",
   "k_density * access_now / max(coverage * k_units_total + strand_reach * k_strand, 1)"
  ],
  [
   "cast_dist",
   "net_range * k_cast_share"
  ],
  [
   "mouth",
   "net_radius + k_mouth_edge"
  ],
  [
   "swept",
   "2 * mouth * max(0, cast_dist - k_shelf) + (cast_dist > k_shelf ? PI * mouth ^ 2 : 0)"
  ],
  [
   "per_cast",
   "min(net_hold, swept * density)"
  ],
  [
   "cast_cycle",
   "k_aim + cast_dist / 26 + k_reel_factor * cast_dist / reel"
  ],
  [
   "ferry_trip",
   "k_ferry_fixed + 2 * k_ferry_leg / boat_speed + k_ferry_per_piece * cargo * (1 - boat_volley_cut)"
  ],
  [
   "ferry_rate",
   "k_ferry_scale * (boats * cargo / ferry_trip)"
  ],
  [
   "access_lucky",
   "max(0, pool_lake_t0 - k_units_t0 * (1 - coverage)) * (net_power + 1 >= 0) + max(0, pool_lake_t1 - k_units_t1 * (1 - coverage)) * (net_power + 1 >= 1) + max(0, pool_lake_t2 - k_units_t2 * (1 - coverage)) * (net_power + 1 >= 2) + max(0, pool_lake_t3 - k_units_t3 * (1 - coverage)) * (net_power + 1 >= 3) + max(0, pool_lake_t4 - k_units_t4 * (1 - coverage)) * (net_power + 1 >= 4) + max(0, pool_strand - k_strand * (1 - strand_reach))"
  ],
  [
   "density_lucky",
   "k_density * access_lucky / max(coverage * k_units_total + strand_reach * k_strand, 1)"
  ],
  [
   "lucky_cast",
   "min(net_hold + k_lucky_extra, swept * density_lucky)"
  ],
  [
   "double_cast",
   "per_cast * k_double_found"
  ],
  [
   "catch_rate",
   "k_catch_scale * (per_cast + lucky_odds * max(0, lucky_cast - per_cast) + double_odds * double_cast) / cast_cycle"
  ],
  [
   "lake_left",
   "(pool_lake_t0 + pool_lake_t1 + pool_lake_t2 + pool_lake_t3 + pool_lake_t4) / k_units_total"
  ],
  [
   "bird_rate",
   "k_bird_swept * k_bird_aim * swept * (1 + double_odds) * min(1, lake_left * 2) / cast_cycle"
  ],
  [
   "dog_near_left",
   "max(0, pool_lake_t0 - k_units_t0 * (1 - dog_coverage))"
  ],
  [
   "dog_beach_share",
   "dog_near_left > 5 ? dog_beach : 1"
  ],
  [
   "dog_rate",
   "dog * min(dog_fetch, k_dog_carry) / (k_dog_trip + max(10 - dog_wait_cut, 3))"
  ]
 ],
