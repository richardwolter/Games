[gd_resource type="Theme" load_steps=9 format=3]

; Project-wide default UI theme — the notebook/child's-comic language from
; ART_BIBLE.md. Set as gui/theme/custom in project.godot, so EVERY Control in
; the game inherits it without each scene wiring a theme.
;
; Numbers here mirror scripts/ui_style.gd (UIStyle). Change both together —
; UIStyle is what code-built UI calls, this is what the editor previews and
; what .tscn-authored Controls get. ui_boot.gd re-asserts the font at runtime.
;
; Sizes are design-canvas (1920x1080) pixels; the window runs 1280x720, so the
; player sees everything at 0.67x. See UIStyle's type-scale doc comment.

[ext_resource type="FontFile" path="res://assets/fonts/DrawFont.ttf" id="1_font"]

[sub_resource type="StyleBoxFlat" id="button_normal"]
